# Server
PORT=4000
NODE_ENV=development

# Comma-separated list of allowed client origins (leave empty to allow all in dev)
CLIENT_URL=http://localhost:3000

# Database
MONGO_URI=mongodb://localhost:27017/taxichat

# Auth
JWT_SECRET_KEY=change-me-to-a-long-random-string
# Format Nd (days), e.g. 30d
JWT_EXPIRES_IN=30d

# Cloudinary (avatars and chat photos)
CLOUDINARY_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Web Push (VAPID). Generate once: npx web-push generate-vapid-keys
# Without these keys the app works, but push notifications are disabled
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@bombila.app

# TURN server for voice calls (deployed in RF, see section 1.7.1 of the concept)
# TURN_URL=turn:turn.example.ru:3478
# TURN_USERNAME=
# TURN_CREDENTIAL=
# TURN_SECRET=

# AI dispatcher (the "Диспетчер" tab)
# AI_PROVIDER: local | groq | gemini | openrouter | gigachat | custom | off
# local  -> llama-server via the reverse tunnel, default http://127.0.0.1:8080/v1
# groq   -> free tier, fast; set AI_API_KEY or a pool in AI_API_KEYS (gsk_...)
# gemini -> free tier, OpenAI-compatible; AI_API_KEY from Google AI Studio
# gigachat -> Sber API, data stays in RF; AI_API_KEY is the OAuth client secret
# "off" keeps the deterministic dispatcher without any model
AI_ENABLED=1
AI_PROVIDER=local
# AI_BASE_URL=https://api.groq.com/openai/v1
# AI_MODEL=openai/gpt-oss-120b
# Key pool: any number of comma-separated keys. Requests are spread over all
# keys in parallel; a 429/401/5xx key is cooled down and the next one is used.
AI_API_KEYS=
# Single-key shorthand, still supported
AI_API_KEY=
# Key of the phone's llama-server (only needed for the local provider)
LOCAL_LLM_API_KEY=
# Parallel generations per key: total parallelism = keys × AI_CONCURRENCY
AI_CONCURRENCY=2
# How many keys one answer may try before giving up (default: all keys)
# AI_KEY_ATTEMPTS=3
AI_TIMEOUT_MS=
AI_MAX_TOKENS=
# GigaChat OAuth scope: GIGACHAT_API_PERS for the free personal tier
AI_GIGACHAT_SCOPE=GIGACHAT_API_PERS
