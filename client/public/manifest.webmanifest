{"name": "Бомбила — такси без посредников", "short_name": "Бомбила", "description": "Заказ частного такси между городами: чат с водителем, офферы, статусы поездки. Установите на телефон — уведомления и звонки работают как в приложении.", "lang": "ru", "start_url": "/", "scope": "/", "display": "standalone", "orientation": "portrait", "background_color": "#0d0d0d", "theme_color": "#0d0d0d", "categories": ["travel", "navigation"], "icons": [{"src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any"}, {"src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any"}, {"src": "/icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable"}]}